# Example env file for local development
# REQUIRED: CI must provide SESSION_SECRET as a repository secret (see .github/workflows/ci.yml)
DATABASE_URL=file:./dev.db
SESSION_SECRET=dev-secret-change-me

# VAPID (Web Push) server keys - set these in production
# These are used by server-side web-push. The server exposes the public key via loader where needed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: If you prefer exposing a build-time client env var, you can set this to the same public key
# Optional client-exposed public key (set to same as VAPID_PUBLIC_KEY if you want the client built with a public key)
# VITE_PUBLIC_VAPID_KEY=
