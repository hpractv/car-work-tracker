generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  createdAt    DateTime    @default(now())
  carMembers   CarMember[]
}

model Car {
  id                   String                   @id @default(cuid())
  make                 String
  model                String
  year                 Int
  currentMileage       Int
  purchaseCost         Float?
  vendor               String?
  description          String?
  imageUrl             String?
  notes                String?
  vin                  String?
  color                String?
  isArchived           Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  members              CarMember[]
  maintenanceRecords   MaintenanceRecord[]
  odometerLogs         OdometerLog[]
  maintenanceOverrides CarMaintenanceOverride[]
  fuelLogs             FuelLog[]
  documents            CarDocument[]
}

model CarMember {
  id     String @id @default(cuid())
  carId  String
  userId String
  role   String
  car    Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([carId, userId])
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  carId       String
  type        String
  date        DateTime
  mileage     Int
  cost        Float?
  vendor      String?
  description String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
  car         Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model MaintenanceType {
  id                    String @id @default(cuid())
  name                  String @unique
  defaultIntervalMiles  Int?
  defaultIntervalMonths Int?
}

model OdometerLog {
  id         String   @id @default(cuid())
  carId      String
  mileage    Int
  note       String?
  recordedAt DateTime @default(now())
  car        Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model CarMaintenanceOverride {
  id             String @id @default(cuid())
  carId          String
  typeName       String
  intervalMiles  Int?
  intervalMonths Int?
  car            Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([carId, typeName])
}

model FuelLog {
  id             String   @id @default(cuid())
  carId          String
  date           DateTime
  mileage        Int
  gallons        Float
  pricePerGallon Float?
  totalCost      Float?
  fullTank       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  car            Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model CarDocument {
  id         String    @id @default(cuid())
  carId      String
  type       String
  title      String
  expiryDate DateTime?
  fileUrl    String?
  notes      String?
  createdAt  DateTime  @default(now())
  car        Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
}
