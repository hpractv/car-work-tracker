{
  "name": "car-work-tracker",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "start": "remix-serve ./build/server/index.js",
    "prisma:push": "prisma db push",
    "prisma:seed": "node --loader ts-node/esm prisma/seed.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "typecheck": "tsc",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:coverage": "vitest --coverage",
    "test:ci:coverage": "vitest --run --coverage",
    "test:e2e": "node ./scripts/e2e-smoke.cjs",
    "gen:vapid": "node ./scripts/generate-vapid.cjs",
    "check:env": "node ./scripts/check-env.cjs",
    "check:pwa-assets": "node ./scripts/check-pwa-assets.cjs",
    "check:no-dev-db": "node ./scripts/check-no-dev-db.cjs",
    "ci": "npm run check:no-dev-db && npm run check:env && npm run typecheck && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@remix-run/node": "^2.15.2",
    "@remix-run/react": "^2.15.2",
    "@remix-run/serve": "^2.15.2",
    "bcryptjs": "^2.4.3",
    "isbot": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remix-auth": "^3.7.0",
    "remix-auth-form": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^21.1.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.14",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^1.0.0"
  }
}
